---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import places from "@/data/places.json";

// 카드 순서: 휴대폰은 위치 허락 시 가까운 순, PC는 무작위(아래 스크립트). 요금제와 무관.
// 가게(type: "shop") 카드는 같은 피드에 섞여 들어간다.
const cats = ["전체", "맛집", "카페", "숙소", "가볼 곳"];
const OWNER_AFTER = 3; // 몇 번째 카드 뒤에 '사장님이신가요?' 띠를 넣을지
---

<Layout title="플레이강릉 | 오직! 강릉">
  <Header />
  <main id="main-content" class="app-layout my-1 pb-10">
    <section class="pg-hero" aria-label="오직! 강릉">
      <img class="pg-hero-bg" src="/brand/hero-9x1.jpg" alt="" />
      <h1 class="font-title">오직! 강릉</h1>
      <img class="pg-hero-front" src="/brand/hero-9x1-front.png" alt="" />
    </section>

    <nav class="pg-cats" aria-label="분류">
      {cats.map((c, i) => (
        <button type="button" data-cat={c} class={i === 0 ? "on" : ""}>{c}</button>
      ))}
    </nav>

    <section id="loc-ask" class="pg-ask" hidden>
      <b>가까운 곳부터 보여 드릴까요?</b>
      <p>지금 계신 곳에서 가장 가까운 강릉의 가게와 장소를 먼저 소개해 드리기 위해 위치를 사용합니다. 위치는 순서를 정하는 데만 쓰고 저장하지 않습니다.</p>
      <div>
        <button type="button" id="loc-yes" class="pg-btn main">가까운 순으로 보기</button>
        <button type="button" id="loc-no" class="pg-btn">괜찮아요</button>
      </div>
    </section>

    <section id="feed" class="pg-feed">
      {places.map((p, i) => (
        <>
          <article class="pg-card" data-cat={p.cat} data-lat={p.lat} data-lng={p.lng} data-type={p.type}>
            <div class="pg-media" aria-hidden="true">
              <span>{p.name}</span>
            </div>
            <div class="pg-body">
              <div class="pg-meta">
                <span class="pg-tag">{p.cat}</span>
                <span class="pg-area">{p.area}</span>
                <span class="pg-dist"></span>
              </div>
              <h2>{p.name}</h2>
              <p>{p.line}</p>
              <div class="pg-actions">
                <a class="pg-btn" target="_blank" rel="noopener" href={`https://map.naver.com/p/search/${encodeURIComponent("강릉 " + p.name)}`}>지도·길찾기</a>
              </div>
            </div>
          </article>
          {i === OWNER_AFTER - 1 && (
            <aside class="pg-owner" data-owner>
              <b>사장님이신가요?</b>
              <p>우리 가게도 여기에 소개하기 — 영상·블로그 제작부터 SNS 게시까지</p>
              <span class="pg-soon">안내 페이지 준비 중</span>
            </aside>
          )}
        </>
      ))}
    </section>
    <p class="pg-credit">맨 위 배너 그림은 실제 강릉 해변 사진을 참고해 AI로 만든 이미지입니다(실제 장소·인물이 아닙니다).</p>
  </main>
  <Footer />
</Layout>

<style is:global>
  /* 배너: 배경 → 입체 글씨 → 사람·차(글씨 앞) 세 겹. 두 그림은 같은 크기·같은 자르기라 정확히 겹친다 */
  .pg-hero { position:relative; height:max(170px, 11.11vw); margin:10px 0 16px; width:100vw; margin-left:calc(50% - 50vw); overflow:hidden; background:#7fb6e8; }
  .pg-hero-bg, .pg-hero-front { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:53.5% 50%; }
  .pg-hero-front { z-index:2; pointer-events:none; }
  .pg-hero h1 { position:absolute; z-index:1; left:0; right:0; top:7%; margin:0; text-align:center; white-space:nowrap;
    font-family:'SeoulNotice',sans-serif; font-weight:900; font-size:min(21vw, max(108px, 7vw)); line-height:1; letter-spacing:-2px; color:#fff;
    text-shadow:1px 1px 0 #d6e3f0, 2px 2px 0 #c3d4e6, 3px 3px 0 #aec4dc, 4px 4px 0 #014d86, 5px 5px 0 #014d86, 6px 6px 0 #013e6d, 8px 10px 14px rgba(0,0,0,.4); }
  .pg-credit { max-width:600px; margin:28px auto 0; font-size:11px; color:var(--muted-foreground); text-align:center; }
  .pg-credit a { text-decoration:underline; }
  .pg-cats { display:flex; justify-content:center; justify-content:safe center; gap:6px; overflow-x:auto; padding:4px 0 14px; }
  .pg-cats button { flex:none; padding:7px 13px; border-radius:999px; border:1px solid var(--border); background:#fff; font-size:14px; cursor:pointer; }
  .pg-cats button.on { background:var(--accent); color:#fff; border-color:var(--accent); font-weight:700; }
  .pg-ask { border:2px solid var(--accent); border-radius:16px; padding:16px 18px; margin-bottom:16px; }
  .pg-ask p { font-size:14px; margin:6px 0 12px; color:var(--muted-foreground); }
  .pg-ask div { display:flex; gap:8px; }
  .pg-btn { display:inline-block; padding:9px 16px; border-radius:10px; border:1px solid var(--border); font-size:14px; background:var(--background); cursor:pointer; text-decoration:none; }
  .pg-btn.main { background:var(--accent); color:#fff; border-color:var(--accent); font-weight:700; }
  .pg-feed { display:grid; gap:18px; grid-template-columns:1fr; }
  .pg-feed, .pg-ask, .pg-col, .pg-cats { max-width:600px; margin-left:auto; margin-right:auto; }
  .pg-ask { margin-bottom:16px; }
  .pg-card { border:1px solid rgba(1,77,134,.10); border-radius:16px; overflow:hidden; background:#fff;
    box-shadow:0 1px 2px rgba(16,40,70,.06), 0 6px 18px rgba(16,40,70,.10); transition:transform .15s, box-shadow .15s; }
  .pg-card:hover { transform:translateY(-2px); box-shadow:0 2px 4px rgba(16,40,70,.08), 0 12px 28px rgba(16,40,70,.16); }
  [data-theme="dark"] .pg-card { background:var(--background); border-color:rgba(255,255,255,.08); box-shadow:0 6px 18px rgba(0,0,0,.45); }
  .pg-feed { gap:22px; }
  .pg-media { aspect-ratio:4/3; display:flex; align-items:center; justify-content:center;
    background:linear-gradient(135deg,#014d86,#3a86c8 60%,#fdf6ec); color:#fff; }
  .pg-media span { font-family:'SeoulNotice',sans-serif; font-weight:700; font-size:28px; text-shadow:0 2px 8px rgba(0,0,0,.35); }
  .pg-body { padding:14px 16px 16px; }
  .pg-meta { display:flex; gap:8px; align-items:center; font-size:13px; color:var(--muted-foreground); }
  .pg-tag { background:#d0161c; color:#fff; padding:2px 8px; border-radius:6px; font-weight:700; }
  .pg-dist { margin-left:auto; color:var(--accent); font-weight:700; }
  .pg-card h2 { font-size:21px; margin:8px 0 4px; }
  .pg-card p { font-size:15px; margin:0; }
  .pg-actions { margin-top:12px; }
  .pg-owner { grid-column:1/-1; border-radius:16px; padding:18px; background:#014d86; color:#fff; box-shadow:0 6px 18px rgba(1,77,134,.30); }
  .pg-owner b { font-family:'SeoulNotice',sans-serif; font-size:20px; }
  .pg-owner p { margin:4px 0 0; font-size:15px; opacity:.92; }
  .pg-soon { display:inline-block; margin-top:8px; font-size:12px; opacity:.7; }
  .pg-hide { display:none; }
</style>

<script>
  const feed = document.getElementById("feed")!;
  const owner = feed.querySelector("[data-owner]")!;
  const cards = () => [...feed.querySelectorAll<HTMLElement>(".pg-card")];

  function place(list: HTMLElement[]) {
    list.forEach((c, i) => { feed.appendChild(c); if (i === 2) feed.appendChild(owner); });
  }
  function shuffle() {
    const l = cards();
    for (let i = l.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [l[i], l[j]] = [l[j], l[i]]; }
    place(l);
  }
  function km(a: number, b: number, c: number, d: number) {
    const r = Math.PI / 180, x = Math.sin(((c - a) * r) / 2) ** 2 + Math.cos(a * r) * Math.cos(c * r) * Math.sin(((d - b) * r) / 2) ** 2;
    return 12742 * Math.asin(Math.sqrt(x));
  }
  function byDistance(lat: number, lng: number) {
    const l = cards().map(c => {
      const d = c.dataset.lat ? km(lat, lng, +c.dataset.lat!, +c.dataset.lng!) : 9999;
      const el = c.querySelector(".pg-dist")!;
      el.textContent = d < 9999 ? (d < 1 ? `${Math.round(d * 1000)}m` : `${d.toFixed(1)}km`) : "";
      return { c, d };
    }).sort((a, b) => a.d - b.d).map(x => x.c);
    place(l);
  }

  const isPhone = matchMedia("(pointer: coarse)").matches;
  const ask = document.getElementById("loc-ask")!;
  shuffle();
  if (isPhone && navigator.geolocation) {
    let saved: string | null = null;
    try { saved = sessionStorage.getItem("pg-loc"); } catch {}
    if (saved !== "no") ask.hidden = false;
  }
  document.getElementById("loc-yes")!.addEventListener("click", () => {
    ask.hidden = true;
    navigator.geolocation.getCurrentPosition(
      p => byDistance(p.coords.latitude, p.coords.longitude),
      () => {},
      { enableHighAccuracy: false, timeout: 8000, maximumAge: 600000 }
    );
  });
  document.getElementById("loc-no")!.addEventListener("click", () => {
    ask.hidden = true;
    try { sessionStorage.setItem("pg-loc", "no"); } catch {}
  });

  document.querySelectorAll<HTMLButtonElement>(".pg-cats button").forEach(b =>
    b.addEventListener("click", () => {
      document.querySelectorAll(".pg-cats button").forEach(x => x.classList.remove("on"));
      b.classList.add("on");
      const c = b.dataset.cat;
      cards().forEach(el => el.classList.toggle("pg-hide", c !== "전체" && el.dataset.cat !== c));
    })
  );
</script>
